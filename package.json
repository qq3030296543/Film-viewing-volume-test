{
  "name": "cine-rank-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "build:netlify": "node scripts/clean-dist.mjs dist && node scripts/clean-dist.mjs release && tsc -b && vite build --outDir release",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
